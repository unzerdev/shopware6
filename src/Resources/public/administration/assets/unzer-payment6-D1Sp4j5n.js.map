{% block unzer_payment_metadata %}
    <mt-card
        class="unzer-payment-metadata"
        :title="$tc('unzer-payment.paymentDetails.metadata.cardTitle')"
    >
        <template #grid>
            {% block unzer_payment_metadata_container %}
            <sw-data-grid
                :dataSource="data"
                :columns="columns"
                :showSelection="false"
                :showActions="false"
            >
                </sw-data-grid>
            {% endblock %}
        </template>
    </mt-card>
{% endblock %}