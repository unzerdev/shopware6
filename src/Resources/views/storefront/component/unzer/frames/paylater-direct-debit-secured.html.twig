{% block unzer_payment_frame_direct_debit_secured_paylater %}
    {% block unzer_payment_checkout_confirm_frame_card_body_title %}
        <div class="card-title">
            {{ context.paymentMethod.translated.name }}
        </div>
    {% endblock %}

    <div class="unzer-payment-paylater-direct-debit-secured-wrapper"
         data-unzer-payment-paylater-direct-debit-secured="true"
         data-unzer-payment-paylater-direct-debit-secured-options=''>

        {% block unzer_payment_frame_installment_paylater_test_data %}
            {% set paymentDataExtensionName = constant("UnzerPayment6\\Components\\Struct\\PageExtension\\Checkout\\Confirm\\UnzerDataPageExtension::EXTENSION_NAME") %}
            {% if page.extensions[paymentDataExtensionName] and page.extensions[paymentDataExtensionName].showTestData %}
                {% sw_include '@Storefront/storefront/component/unzer/frames/testdata/paylater-direct-debit-secured.html.twig' %}
            {% endif %}
        {% endblock %}

        {% block unzer_payment_frame_paylater_direct_debit_ui_element %}
            <unzer-payment
                    id="unzer-payment-component"
                    publicKey="{{ page.extensions.unzerPaymentData.publicKey }}"
                    {% if page.extensions.unzerPaymentData.keyPairConfig %}skipFetchingMerchantConfig{% endif %}
                    locale="{{ page.extensions.unzerPaymentData.locale }}">
                <unzer-paylater-direct-debit></unzer-paylater-direct-debit>
            </unzer-payment>
        {% endblock %}
    </div>
{% endblock %}
