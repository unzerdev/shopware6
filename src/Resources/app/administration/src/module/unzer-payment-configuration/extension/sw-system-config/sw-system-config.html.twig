{% block sw_system_config_content_card_field %}
    <template
        v-if="element.name != 'UnzerPayment6.settings.applePayPaymentProcessingCertificateId' && element.name != 'UnzerPayment6.settings.applePayMerchantIdentificationCertificateId'"
    >
        <template v-if="element.name == 'UnzerPayment6.settings.googlePayMerchantId'">
            <sw-text-field
                :value="unzerGooglePayGatewayMerchantId"
                :label="$tc('unzer-payment-settings.google-pay.gatewayMerchantId')"
                disabled
            >
            </sw-text-field>
        </template>
        {% parent() %}
    </template>
{% endblock %}